MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=spendsense_pw
MYSQL_DATABASE=spendsense
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=spendsense_logs
AUTH_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

